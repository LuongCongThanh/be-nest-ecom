# Phase B Exit Gate — API Verification
# Requires VS Code extension: REST Client (humao.rest-client)
# Run each request with "Send Request" above the ### line

@baseUrl = http://localhost:3000
@apiUrl  = {{baseUrl}}/api/v1

# ─── Thay các biến này sau khi lấy được token ───
@accessToken  = YOUR_ACCESS_TOKEN
@refreshToken = YOUR_REFRESH_TOKEN
@adminToken   = YOUR_ADMIN_TOKEN

###############################################
# 1. INFRASTRUCTURE
###############################################

### [infra-1] Health live
GET {{baseUrl}}/health

### [infra-2] Health ready (DB connected)
GET {{baseUrl}}/health/ready

###############################################
# 2. AUTH ENDPOINTS
###############################################

### [auth-1] Register — 201 + tokens, no password field
POST {{apiUrl}}/auth/register
Content-Type: application/json

{
  "email": "gate-test@example.com",
  "password": "Test@123456",
  "firstName": "Gate",
  "lastName": "Test"
}

### [auth-2] Register duplicate email — 409 EMAIL_ALREADY_EXISTS
POST {{apiUrl}}/auth/register
Content-Type: application/json

{
  "email": "gate-test@example.com",
  "password": "Test@123456",
  "firstName": "Gate",
  "lastName": "Test"
}

### [auth-3] Register invalid body — 422 VALIDATION_FAILED + errors array
POST {{apiUrl}}/auth/register
Content-Type: application/json

{
  "email": "not-an-email",
  "password": "short"
}

### [auth-4] Login correct credentials — 200 + tokens
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "gate-test@example.com",
  "password": "Test@123456"
}

### [auth-5] Login wrong password — 401 INVALID_CREDENTIALS
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "gate-test@example.com",
  "password": "WrongPassword1"
}

### [auth-6] Login email not found — 401 INVALID_CREDENTIALS (same message as auth-5)
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "nobody@example.com",
  "password": "Test@123456"
}

### [auth-7] Refresh valid RT — new token pair, RT cũ có usedAt != null
POST {{apiUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### [auth-8] Refresh used RT — 401 REFRESH_TOKEN_REPLAY_DETECTED + family revoked
# (dùng lại refreshToken cũ sau khi đã refresh ở auth-7)
POST {{apiUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### [auth-9] Logout — 204, refresh sau đó fail
POST {{apiUrl}}/auth/logout
Authorization: Bearer {{accessToken}}

### [auth-10] Logout-all — 204, tất cả RT của user bị revoke
POST {{apiUrl}}/auth/logout-all
Authorization: Bearer {{accessToken}}

###############################################
# 3. USERS ENDPOINTS
###############################################

### [user-1] GET /users/me valid token — user info, no password
GET {{apiUrl}}/users/me
Authorization: Bearer {{accessToken}}

### [user-2] GET /users/me no token — 401 TOKEN_INVALID
GET {{apiUrl}}/users/me

### [user-3] GET /users/me expired token — 401 TOKEN_EXPIRED
# Dùng một expired token để test (tạo thủ công hoặc chờ hết hạn)
GET {{apiUrl}}/users/me
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJ0ZXN0IiwiZXhwIjoxfQ.EXPIRED

### [user-4] PATCH /users/me — update thành công
PATCH {{apiUrl}}/users/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "firstName": "Updated"
}

### [user-5] PATCH /users/me/change-password correct — 204, tokens revoked
PATCH {{apiUrl}}/users/me/change-password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "currentPassword": "Test@123456",
  "newPassword": "NewTest@123456"
}

### [user-6] PATCH /users/me/change-password wrong current — 401 INVALID_CREDENTIALS
PATCH {{apiUrl}}/users/me/change-password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "currentPassword": "WrongPassword1",
  "newPassword": "NewTest@123456"
}

### [user-7] GET /users (admin) — list users, no password
GET {{apiUrl}}/users
Authorization: Bearer {{adminToken}}

### [user-8] GET /users (user token) — 403 FORBIDDEN
GET {{apiUrl}}/users
Authorization: Bearer {{accessToken}}

###############################################
# 4. SECURITY CHECKS
###############################################

### [sec-1] 404 route — JSON response, not Express HTML
GET {{baseUrl}}/this-route-does-not-exist

### [sec-2] Trigger 500 (dùng Swagger hoặc endpoint đặc biệt nếu có)
# Nếu không có endpoint test 500, skip và verify thủ công từ log

###############################################
# Admin login (để lấy adminToken)
###############################################

### [admin-login] Login admin — lấy adminToken
POST {{apiUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@ecom.dev",
  "password": "Admin@123456"
}
