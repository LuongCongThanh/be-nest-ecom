# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/ecom_db

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Secret dùng để ký access token — tối thiểu 32 ký tự, random string
JWT_SECRET=replace-with-random-secret-minimum-32-chars
# Thời hạn access token (format: https://github.com/vercel/ms)
JWT_EXPIRES_IN=30m
# Thời hạn refresh token lưu trong DB
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Redis ───────────────────────────────────────────────────────────────────
# URL kết nối Redis — dùng cho blacklist token và cache
REDIS_URL=redis://localhost:6379

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3001

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_FORMAT=pretty
LOG_LEVEL=debug

# ─── Object Storage (S3-compatible: MinIO / Cloudflare R2) ───────────────────
# MinIO local dev:
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET=ecom-images
STORAGE_PUBLIC_URL=http://localhost:9000/ecom-images
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true

# Cloudflare R2 (production):
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY_ID=your-r2-access-key-id
# STORAGE_SECRET_ACCESS_KEY=your-r2-secret-access-key
# STORAGE_BUCKET=your-bucket-name
# STORAGE_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
# STORAGE_REGION=auto
# STORAGE_FORCE_PATH_STYLE=false
