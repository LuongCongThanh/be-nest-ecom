# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/ecom_db

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Secret dùng để ký access token — tối thiểu 32 ký tự, random string
JWT_SECRET=replace-with-random-secret-minimum-32-chars
# Thời hạn access token (format: https://github.com/vercel/ms)
JWT_EXPIRES_IN=30m
# Thời hạn refresh token lưu trong DB
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Redis ───────────────────────────────────────────────────────────────────
# URL kết nối Redis — dùng cho blacklist token và cache
REDIS_URL=redis://localhost:6379

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3001

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_FORMAT=pretty
LOG_LEVEL=debug

# ─── Cloudflare R2 (file storage) ────────────────────────────────────────────
# Account ID: Cloudflare dashboard → R2 → Overview
R2_ACCOUNT_ID=your-cloudflare-account-id
# Bucket name tạo trong R2
R2_BUCKET_NAME=your-bucket-name
# R2 API token credentials (Settings → R2 API Tokens)
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Public URL của bucket (bật "Public access" trong R2 bucket settings)
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
