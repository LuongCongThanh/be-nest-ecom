generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  firstName     String?
  lastName      String?
  phone         String?
  role          Role           @default(USER)
  isActive      Boolean        @default(true)
  emailVerified Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  addresses      Address[]
  refreshTokens  RefreshToken[]
  stockMovements StockMovement[]
  cart           Cart?
  orders         Order[]

  @@index([deletedAt])
  @@map("users")
}

model Address {
  id            String    @id @default(uuid())
  userId        String
  label         String?
  recipientName String
  phone         String
  street        String
  ward          String?
  district      String
  city          String
  country       String    @default("VN")
  isDefault     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deletedAt])
  @@map("addresses")
}

model RefreshToken {
  id                 String         @id @default(uuid())
  userId             String
  familyId           String
  tokenHash          String         @unique
  replacedByTokenId  String?        @unique
  usedAt             DateTime?
  revokedAt          DateTime?
  expiresAt          DateTime
  createdAt          DateTime       @default(now())
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy         RefreshToken?  @relation("TokenRotation", fields: [replacedByTokenId], references: [id])
  replacedFrom       RefreshToken?  @relation("TokenRotation")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum Role {
  USER
  STAFF
  ADMIN
}

model Category {
  id          String     @id @default(uuid())
  name        String
  // Not @unique here — uniqueness is enforced only among non-deleted rows via a
  // partial index added by raw SQL in the migration (see add_category_slug_partial_unique).
  slug        String
  description String?
  image       String?
  parentId    String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]

  @@index([parentId])
  @@index([slug])
  @@index([deletedAt])
  @@index([parentId, deletedAt, sortOrder])
  @@map("categories")
}

model Product {
  id                String         @id @default(uuid())
  sku               String         @unique
  name              String
  slug              String         @unique
  description       String?
  price             BigInt
  comparePrice      BigInt?
  stockQuantity     Int            @default(0)
  lowStockThreshold Int            @default(5)
  isActive          Boolean        @default(true)
  isFeatured        Boolean        @default(false)
  metadata          Json?
  categoryId        String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  category          Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images            ProductImage[]
  stockMovements    StockMovement[]
  cartItems         CartItem[]
  orderItems        OrderItem[]

  @@index([categoryId])
  @@index([slug])
  @@index([sku])
  @@index([isActive, deletedAt])
  @@map("products")
}

enum ImageSize {
  THUMB
  MEDIUM
  ORIGINAL
}

enum StockMovementType {
  INBOUND
  OUTBOUND
  RETURN
  ADJUSTMENT
}

model StockMovement {
  id            String            @id @default(uuid())
  productId     String
  type          StockMovementType
  delta         Int
  balanceAfter  Int
  reason        String?
  referenceType String?
  referenceId   String?
  performedById String?
  createdAt     DateTime          @default(now())

  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  performedBy   User?             @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@map("stock_movements")
}

model ProductImage {
  id        String    @id @default(uuid())
  productId String
  key       String
  url       String
  size      ImageSize
  width     Int
  height    Int
  position  Int       @default(0)
  altText   String?
  createdAt DateTime  @default(now())

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size, position])
  @@index([productId])
  @@map("product_images")
}

model Cart {
  id           String     @id @default(uuid())
  userId       String?    @unique
  sessionId    String?
  lastActivity DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        CartItem[]

  @@index([sessionId])
  @@index([lastActivity])
  @@map("carts")
}

model CartItem {
  id           String   @id @default(uuid())
  cartId       String
  productId    String
  variantId    String?
  quantity     Int
  priceAtAdded BigInt
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cart         Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cartId, productId])
  @@map("cart_items")
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPING
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model Order {
  id                       String        @id @default(uuid())
  orderNumber              String        @unique
  userId                   String?
  customerEmailSnapshot    String
  status                   OrderStatus   @default(PENDING)
  subtotal                 BigInt
  shippingFee              BigInt
  discountAmount           BigInt        @default(0)
  vatTotal                 BigInt        @default(0)
  grandTotal               BigInt
  shippingAddressSnapshot  Json
  shippingMethod           String
  paymentStatus            PaymentStatus @default(UNPAID)
  paymentProvider          String
  paymentRef               String?
  placedAt                 DateTime      @default(now())
  cancelledAt              DateTime?
  deliveredAt              DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  user                     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  items                    OrderItem[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id               String   @id @default(uuid())
  orderId          String
  productId        String
  variantId        String?
  productSnapshot  Json
  unitPrice        BigInt
  quantity         Int
  lineTotal        BigInt
  createdAt        DateTime @default(now())

  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}
