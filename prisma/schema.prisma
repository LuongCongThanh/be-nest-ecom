generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  firstName     String?
  lastName      String?
  phone         String?
  role          Role           @default(USER)
  isActive      Boolean        @default(true)
  emailVerified Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  addresses     Address[]
  refreshTokens RefreshToken[]

  @@index([deletedAt])
  @@map("users")
}

model Address {
  id            String    @id @default(uuid())
  userId        String
  label         String?
  recipientName String
  phone         String
  street        String
  ward          String?
  district      String
  city          String
  country       String    @default("VN")
  isDefault     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deletedAt])
  @@map("addresses")
}

model RefreshToken {
  id                 String         @id @default(uuid())
  userId             String
  familyId           String
  tokenHash          String         @unique
  replacedByTokenId  String?        @unique
  usedAt             DateTime?
  revokedAt          DateTime?
  expiresAt          DateTime
  createdAt          DateTime       @default(now())
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy         RefreshToken?  @relation("TokenRotation", fields: [replacedByTokenId], references: [id])
  replacedFrom       RefreshToken?  @relation("TokenRotation")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum Role {
  USER
  STAFF
  ADMIN
}
