# Copy to `.env.production` on the VPS and fill in real values.
# `.env.production` must NEVER be committed — keep it only on the server.

# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Postgres container creds (also referenced by docker-compose.prod.yml) ───
POSTGRES_USER=ecom_user
POSTGRES_PASSWORD=replace-with-a-strong-random-password
POSTGRES_DB=ecom_db

# ─── Database — service name "postgres" is the container hostname on the compose network
DATABASE_URL=postgresql://ecom_user:replace-with-a-strong-random-password@postgres:5432/ecom_db

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-random-secret-minimum-32-chars
JWT_EXPIRES_IN=30m
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Redis — service name "redis" is the container hostname on the compose network
REDIS_URL=redis://redis:6379

# ─── CORS — set to your real frontend origin(s), comma-separated. Never "*" in prod.
CORS_ORIGINS=https://yourdomain.com

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_FORMAT=json
LOG_LEVEL=info

# ─── Object Storage — Cloudflare R2 recommended for production (S3-compatible,
# generous free tier, no need to self-host/expose MinIO on the VPS)
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=your-r2-access-key-id
STORAGE_SECRET_ACCESS_KEY=your-r2-secret-access-key
STORAGE_BUCKET=your-bucket-name
STORAGE_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
STORAGE_REGION=auto
STORAGE_FORCE_PATH_STYLE=false

# ─── Home-server deploy (docker-compose.home.yml) — ngrok tunnel + self-hosted MinIO
# through nginx instead of R2. See docs/DEPLOYMENT-HOME.md. Uncomment this block and
# comment out the R2 block above instead.
# NGROK_AUTHTOKEN=your-ngrok-authtoken
# NGROK_DOMAIN=yourname.ngrok-free.app
# STORAGE_ENDPOINT=https://yourname.ngrok-free.app/storage
# STORAGE_ACCESS_KEY_ID=replace-with-a-random-access-key
# STORAGE_SECRET_ACCESS_KEY=replace-with-a-random-secret-min-8-chars
# STORAGE_BUCKET=ecom-images
# STORAGE_PUBLIC_URL=https://yourname.ngrok-free.app/storage/ecom-images
# STORAGE_REGION=us-east-1
# STORAGE_FORCE_PATH_STYLE=true
